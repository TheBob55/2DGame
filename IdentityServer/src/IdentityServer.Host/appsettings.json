{
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\mssqllocaldb;Database=DuendeIdentityServer;Trusted_Connection=True;MultipleActiveResultSets=true"
  },
  "AzureAd": {
    "Authority": "https://login.microsoftonline.com/{YOUR_TENANT_ID}/v2.0",
    "ClientId": "{YOUR_CLIENT_ID}",
    "ClientSecret": "{YOUR_CLIENT_SECRET}",
    "TenantId": "{YOUR_TENANT_ID}",
    "CallbackPath": "/signin-azuread"
  },
  "AdminUI": {
    "AllowedOrigins": [
      "https://localhost:5001",
      "https://localhost:5002"
    ],
    "AdminUsers": [
      "admin@yourdomain.com"
    ]
  },
  "IdentityServer": {
    "IssuerUri": "https://localhost:5001",
    "PublicOrigin": "https://localhost:5001"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
